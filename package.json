{
  "name": "cms-multiseccion",
  "version": "0.1.0",
  "description": "CMS-MULTISECCION: CMS de sitio único con múltiples secciones y administración delegada por sección.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24.7.0"
  },
  "main": "backend/server.js",
  "scripts": {
    "start": "node --env-file-if-exists=.env backend/server.js",
    "dev": "node --env-file-if-exists=.env --watch-path=backend backend/server.js",
    "check": "node --env-file-if-exists=.env scripts/check-env.js",
    "db:migrate": "node --env-file-if-exists=.env scripts/db.js migrate",
    "db:status": "node --env-file-if-exists=.env scripts/db.js status",
    "backup:create": "node --env-file-if-exists=.env scripts/backup.js create",
    "backup:list": "node --env-file-if-exists=.env scripts/backup.js list",
    "backup:verify": "node --env-file-if-exists=.env scripts/backup.js verify",
    "backup:verify-dir": "node scripts/backup.js verify-dir",
    "backup:prune": "node --env-file-if-exists=.env scripts/backup.js prune",
    "backup:restore": "node --env-file-if-exists=.env scripts/backup.js restore",
    "admin:create": "node --env-file-if-exists=.env scripts/admin.js create",
    "admin:reset-password": "node --env-file-if-exists=.env scripts/admin.js reset-password",
    "test": "node --test \"tests/**/*.test.js\"",
    "test:unit": "node --test \"tests/unit/**/*.test.js\"",
    "test:integration": "node --test \"tests/integration/**/*.test.js\"",
    "test:security": "node --test \"tests/security/**/*.test.js\"",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-exclude=\"tests/**\" \"tests/**/*.test.js\"",
    "test:browser": "node tests/browser/run.js",
    "bench": "node scripts/bench.js",
    "build:editor": "node scripts/build-editor.js"
  },
  "devDependencies": {
    "@tiptap/core": "3.33.0",
    "@tiptap/extension-blockquote": "3.33.0",
    "@tiptap/extension-list": "3.33.0",
    "@tiptap/extension-table": "3.33.0",
    "@tiptap/pm": "3.33.0",
    "@tiptap/starter-kit": "3.33.0",
    "esbuild": "0.28.2"
  }
}
