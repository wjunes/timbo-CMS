{
  "name": "cms-multiseccion",
  "version": "0.1.0",
  "description": "CMS-MULTISECCION: CMS de sitio único con múltiples secciones y administración delegada por sección.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24.7.0"
  },
  "main": "backend/server.js",
  "scripts": {
    "start": "node --env-file-if-exists=.env backend/server.js",
    "dev": "node --env-file-if-exists=.env --watch-path=backend backend/server.js",
    "check": "node --env-file-if-exists=.env scripts/check-env.js",
    "db:migrate": "node --env-file-if-exists=.env scripts/db.js migrate",
    "db:status": "node --env-file-if-exists=.env scripts/db.js status",
    "admin:create": "node --env-file-if-exists=.env scripts/admin.js create",
    "admin:reset-password": "node --env-file-if-exists=.env scripts/admin.js reset-password",
    "test": "node --test \"tests/**/*.test.js\"",
    "test:unit": "node --test \"tests/unit/**/*.test.js\"",
    "test:integration": "node --test \"tests/integration/**/*.test.js\"",
    "test:security": "node --test \"tests/security/**/*.test.js\""
  }
}
