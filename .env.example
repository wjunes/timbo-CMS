# CMS-MULTISECCION — variables de entorno
# Copiar a `.env` y ajustar. `.env` NO se versiona.
# Las variables definidas en el entorno real tienen prioridad sobre este archivo.
# Este archivo no debe contener secretos reales.

# Entorno de ejecución: development | test | production
NODE_ENV=development

# Interfaz y puerto de escucha. En desarrollo se recomienda 127.0.0.1.
HOST=127.0.0.1
PORT=3000

# URL pública del sitio, sin barra final, query ni credenciales.
# Opcional en desarrollo (se deriva de HOST y PORT). OBLIGATORIA y con https en producción.
# APP_BASE_URL=https://cms.example.org

# Nivel de registro: error | warn | info | debug
LOG_LEVEL=info

# Ruta del archivo SQLite. Relativa a la raíz del proyecto o absoluta.
# Debe estar en un disco local: nunca en carpetas sincronizadas (OneDrive, Dropbox…)
# ni en unidades de red (WAL lo requiere). No puede estar dentro de frontend/.
# ":memory:" solo se admite fuera de producción (pruebas).
DATABASE_PATH=database/cms.db

# Directorio de archivos (media/, private/, backups/). Fuera de lo público y no versionado.
STORAGE_DIR=storage

# Duración máxima de la sesión en horas (1-72) y cierre por inactividad en minutos (5-1440).
SESSION_TTL_HOURS=8
SESSION_IDLE_MINUTES=30

# Confiar en X-Forwarded-For (IP del cliente para el límite de intentos).
# Activar SOLO detrás de un proxy inverso propio que sobrescriba esa cabecera;
# si no, cualquier cliente podría falsificar su IP.
TRUST_PROXY=false
