# Configuración de producción de CMS-MULTISECCIÓN (ver docs/DEPLOYMENT.md).
# Copiar a /etc/cms-multiseccion/cms.env, con propietario root:cms y modo 0640.
# No contiene secretos: la aplicación no necesita ninguno (las sesiones son
# aleatorias y las contraseñas se guardan con Argon2id).

NODE_ENV=production
# Solo en local: el acceso desde fuera es por el proxy HTTPS.
HOST=127.0.0.1
PORT=3000
APP_BASE_URL=https://cms.example.org
# El proxy pone la IP real del cliente en X-Forwarded-For.
TRUST_PROXY=true
LOG_LEVEL=info

DATABASE_PATH=/var/lib/cms-multiseccion/database/cms.db
STORAGE_DIR=/var/lib/cms-multiseccion/storage

MEDIA_MAX_BYTES=10485760
SESSION_TTL_HOURS=8
SESSION_IDLE_MINUTES=30

BACKUP_INTERVAL_HOURS=24
BACKUP_KEEP=14

RATE_LIMIT_REQUESTS_PER_MINUTE=1200
RATE_LIMIT_WRITES_PER_MINUTE=120
