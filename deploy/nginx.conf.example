# Alternativa a Caddy: CMS-MULTISECCIÓN detrás de nginx (ver docs/DEPLOYMENT.md).
# Los certificados se obtienen aparte (p. ej. certbot) y aquí solo se referencian.
# Sustituya cms.example.org por su dominio.

# Límite de peticiones por IP en el proxy (además del de la aplicación).
limit_req_zone $binary_remote_addr zone=cms:10m rate=20r/s;

server {
    listen 80;
    listen [::]:80;
    server_name cms.example.org;
    # HTTPS obligatorio: todo lo que llega por http se redirige.
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name cms.example.org;

    ssl_certificate     /etc/letsencrypt/live/cms.example.org/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/cms.example.org/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;

    server_tokens off;
    # Subidas de hasta MEDIA_MAX_BYTES (10 MiB) y documentos de hasta 2,25 MiB.
    client_max_body_size 12m;
    client_body_timeout 120s;

    location / {
        limit_req zone=cms burst=60 nodelay;
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        # Sobrescribe (no añade) la cabecera: la aplicación toma la entrada más a
        # la derecha con TRUST_PROXY=true.
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 120s;
        # Las respuestas ya traen sus cabeceras de seguridad y de caché.
        proxy_buffering on;
    }
}
